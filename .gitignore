# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Secrets
.env
.env.*
!.env.example

# ML artifacts / data (versioned snapshots are tracked separately)
ml/artifacts/*
!ml/artifacts/.gitkeep
data/raw/
data/processed/

# Flutter
flutter_app/build/
flutter_app/.dart_tool/
flutter_app/.flutter-plugins*
flutter_app/android/local.properties

# OS / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/

# Launch video: keep the deliverables and build scripts, never the captured
# login token, API responses or render cache in work/
brag-output/work/*
!brag-output/work/video.html
!brag-output/work/capture.js
!brag-output/work/music.py
!brag-output/work/styles.css

# Copy to .env and fill in. Never commit .env.

# --- App ---
# development | test | production
APP_ENV=development
LOG_LEVEL=INFO

# --- PostgreSQL (docker-compose uses these too) ---
POSTGRES_USER=aerogard
POSTGRES_PASSWORD=aerogard_dev_password
POSTGRES_DB=aerogard
POSTGRES_PORT=5433
DATABASE_URL=postgresql+psycopg://aerogard:aerogard_dev_password@localhost:5433/aerogard
TEST_DATABASE_URL=postgresql+psycopg://aerogard:aerogard_dev_password@localhost:5433/aerogard_test

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- External data sources (needed from Phase 2) ---
OPENAQ_API_KEY=
DATA_GOV_IN_API_KEY=
# Open-Meteo needs no key for non-commercial use.
